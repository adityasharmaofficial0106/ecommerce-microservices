# Copy to .env (which is git-ignored) and replace every "change-me" value.
#   cp .env.example .env
# Docker Compose reads .env automatically. For running services from your IDE
# or with mvn spring-boot:run, export these variables into your shell first.
#
# On Windows, scripts/run.ps1 loads this file for you.

# PostgreSQL superuser (only used by the container and the init script)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me
POSTGRES_PORT=5432

# One database login per service - each can only connect to its own database
USER_DB_USERNAME=user_service
USER_DB_PASSWORD=change-me

PRODUCT_DB_USERNAME=product_service
PRODUCT_DB_PASSWORD=change-me

ORDER_DB_USERNAME=order_service
ORDER_DB_PASSWORD=change-me

# pgAdmin (the "tools" compose profile).
# Compose validates EVERY service in the file even when you start only one, and
# PGADMIN_PASSWORD is declared as required - so leaving it unset makes
# "docker compose up -d postgres" fail with a message about pgAdmin.
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me

# --- Token signing -----------------------------------------------------------
# Tokens are signed with an RSA key pair (RS256), not a shared secret.
#
# There is nothing to fill in here. user-service generates the pair on its first
# startup and writes it to the directory below; the other two services read only
# the public half. Both files are git-ignored.
#
# This is why user-service must be started FIRST on a fresh checkout: without
# keys/jwt-public.pem, product-service and order-service refuse to start.
#
# Uncomment only to put the keys somewhere other than ./keys:
# JWT_KEY_DIR=../keys
# JWT_PUBLIC_KEY_PATH=../keys/jwt-public.pem

# How long an issued token stays valid. Short on purpose: a token cannot be
# revoked, so expiry is what bounds the damage if one leaks.
JWT_EXPIRY_MINUTES=15
